# ============================================================
# .env.example — Safe to commit. Copy to .env and fill in values.
# ============================================================

# ---- Project ----
PROJECT_NAME=podcast-ai-saas
DOMAIN=localhost

# ---- Frontend (local dev only) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ML_URL=http://localhost:8001

# ---- Database (REQUIRED) ----
# Local: postgresql://user:pass@localhost:5432/podcast
# Railway: copy from Railway → Postgres service → Connect tab
DATABASE_URL=postgresql://user:pass@localhost:5432/podcast

# ---- Redis (OPTIONAL) ----
# Leave empty to run without Redis (quota/rate-limiting features disabled)
# Railway: copy from Railway → Redis service → Connect tab
REDIS_URL=

# ---- Security (REQUIRED) ----
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ---- Podchaser API ----
PODCHASER_API_KEY=
PODCHASER_API_SECRET=

# ---- Razorpay (configure when payments go live) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Internal Service URLs ----
# Docker Compose (local): use service names below
# Railway: replace with actual deployed service URLs
ML_SERVICE_URL=http://ml-service:8001
INGESTION_SERVICE_URL=http://ingestion-service:8002

# ---- ML Service ----
MODEL_NAME=podcast_match_v1
TORCH_DEVICE=cpu
