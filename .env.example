# Root .env.example - Source of truth for local development / demo
# This file is safe to commit. Do NOT put real production secrets here.

# Global
PROJECT_NAME=podlink-backend
DOMAIN=localhost

# Backend (FastAPI)
DATABASE_URL=postgresql://user:pass@localhost:5432/podcast
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change_me_in_real_env
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Podchaser (use dummy or test keys for demo)
PODCHASER_API_KEY=dummy_podchaser_key
PODCHASER_API_SECRET=dummy_podchaser_secret

# Razorpay (use dummy keys unless actually integrating payments)
RAZORPAY_KEY_ID=dummy_razorpay_key
RAZORPAY_KEY_SECRET=dummy_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=dummy_razorpay_webhook

# ML Service
MODEL_NAME=podcast_match_v1
TORCH_DEVICE=cpu

# Infrastructure defaults for local docker-compose
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=podcast
REDIS_PASSWORD=pass

